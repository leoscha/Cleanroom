CLEANROOM_WORKSPACE_DIR=.
CLEANROOM_DIRTY_DIR=./dirty
CLEANROOM_SPOTLESS_DIR=./spotless
CLEANROOM_PROCESSED_DIR=./processed
CLEANROOM_FAILED_DIR=./failed
CLEANROOM_REPORTS_DIR=./reports
CLEANROOM_QUARANTINE_DIR=./spotless/quarantine
CLEANROOM_TEMP_DIR=./.cleanroom/tmp
CLEANROOM_DATABASE_URL=sqlite:///./cleanroom.db
CLEANROOM_POLICY_PATH=./config/default-policy.yaml

OLLAMA_BASE_URL=http://100.x.x.x:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2

CLEANROOM_MIN_CONFIDENCE=0.70
CLEANROOM_MAX_FILE_SIZE_MB=20
CLEANROOM_SUPPORTED_EXTENSIONS=.txt,.pdf
CLEANROOM_FILE_STABILITY_SECONDS=3
CLEANROOM_CHUNK_MAX_CHARS=12000
CLEANROOM_CHUNK_OVERLAP_CHARS=500
CLEANROOM_MAX_CHUNKS_PER_FILE=100
CLEANROOM_VERIFY_OUTPUT=true
CLEANROOM_OLLAMA_VERIFY=true
CLEANROOM_WRITE_REVIEW_DIFF=false
CLEANROOM_ARCHIVE_PROCESSED=true
CLEANROOM_PDF_REPLACEMENT_MODE=label
CLEANROOM_PDF_REMOVE_METADATA=true
CLEANROOM_PDF_REMOVE_ANNOTATIONS=true
CLEANROOM_PDF_REJECT_FORMS=true
CLEANROOM_PDF_REJECT_EMBEDDED_FILES=true
CLEANROOM_PDF_REJECT_JAVASCRIPT=true
CLEANROOM_PDF_MIN_TEXT_CHARS_PER_PAGE=20
CLEANROOM_PDF_MAPPING_MIN_CONFIDENCE=0.95
CLEANROOM_LOG_LEVEL=INFO
CLEANROOM_API_HOST=127.0.0.1
CLEANROOM_ALLOW_PUBLIC_OLLAMA=false
CLEANROOM_EVAL_MIN_REQUIRED_RECALL=0.95
CLEANROOM_EVAL_MIN_PRECISION=0.70
